{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/GPT-4.1",
  "autoupdate": true,
  "instructions": [
    "docs/coding-review.md",
    "docs/coding-style.md",
    "docs/development-workflow.md",
    "docs/git-workflow.md",
    "docs/hooks.md",
    "docs/patterns.md",
    "docs/performance.md",
    "docs/security.md",
    "docs/testing.md"
  ],
  "mcp": {
    "afas": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "cd $HOME/Documents/NAVARA/repos/afas-client && npm run mcp:afas"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "$HOME/dotfiles"
      ],
      "enabled": true,
      "timeout": 5000
    },
    "sonarqube": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--init",
        "--pull=always",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_URL",
        "mcp/sonarqube"
      ],
      "env": {
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}",
        "SONARQUBE_URL": "https://sonar.pwcinternal.com"
      },
      "enabled": true,
      "timeout": 10000
    }
  },
  "plugin": ["opencode-skill-creator", "oh-my-openagent@latest", "superpowers@git+https://github.com/obra/superpowers.git"]
}
